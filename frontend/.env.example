# Next.js server-to-server Go API origin (no /api suffix)
API_BASE_URL=http://localhost:8080

# OpenCage Geocoding API key (server-only)
# Get your free key at: https://opencagedata.com/
OPENCAGE_API_KEY=

# Required for CARTO dark raster map tiles; get a free key at:
# https://docs.carto.com/faqs/carto-basemaps
NEXT_PUBLIC_CARTO_API_KEY=
