# Copy this file to .env and edit values
#   cp .env.example .env

PORT=8080
DATABASE_URL=postgres://user:pass@db:5432/shipments
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=dev-only-change-in-production
# Next.js is the local frontend; CORS is not authorization for protected writes.
CORS_ORIGIN=http://localhost:3000

# Set these in the deployment secret manager, not in source control.
ADMIN_NAME="Shipment Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set true for the first cutover only, after verified backup; then set false.
ADMIN_ROLE_CUTOVER=false
